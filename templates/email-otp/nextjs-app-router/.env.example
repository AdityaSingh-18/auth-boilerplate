DATABASE_URL="your_neon_database_connection_string"

# Generate separate random secrets for these values.
AUTH_SECRET="replace_with_a_random_secret_at_least_32_characters_long"
OTP_SECRET="replace_with_a_different_random_secret_at_least_32_characters_long"

# SMTP email configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="Your App <your-email@gmail.com>"