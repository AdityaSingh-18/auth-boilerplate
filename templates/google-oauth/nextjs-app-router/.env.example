DATABASE_URL="your_neon_database_connection_string"

# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret_at_least_32_bytes_long"

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Must exactly match the redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Your application's base URL
APP_URL="http://localhost:3000"
