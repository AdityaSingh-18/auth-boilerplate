DATABASE_URL="your_neon_database_connection_string"

# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret_at_least_32_bytes_long"
MAGIC_LINK_SECRET="replace_with_a_different_random_secret_at_least_32_bytes_long"

# Your application's base URL
APP_URL="http://localhost:3000"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="Your App <no-reply@example.com>"
