# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Create an OIDC application with your identity provider.
OIDC_CLIENT_ID="your-oidc-client-id"
OIDC_CLIENT_SECRET="your-oidc-client-secret"

# Must exactly match the redirect URI registered with your OIDC provider.
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/oidc/callback"

# Public base URL of this application.
APP_URL="http://localhost:3000"