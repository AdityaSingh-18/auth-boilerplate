# Neon PostgreSQL connection string
DATABASE_URL="postgresql://<username>:<password>@<host>/<database>?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="<your-auth-secret-minimum-32-bytes>"

# Public base URL of this application
APP_URL="http://localhost:3000"

# Service Provider (SP) entity ID
SAML_SP_ENTITY_ID="http://localhost:3000/saml/metadata"

# Exact Assertion Consumer Service URL registered with your IdP
SAML_ACS_URL="http://localhost:3000/api/auth/saml/acs"

# Identity Provider (IdP) configuration
SAML_IDP_ENTRY_POINT="https://<your-idp-domain>/sso/saml"
SAML_IDP_ISSUER="https://<your-idp-domain>/entity"

# Trusted IdP signing certificate in PEM format
# Replace with the certificate provided by your Identity Provider.
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n<your-idp-certificate>\n-----END CERTIFICATE-----"

# Required only when your IdP requires signed AuthnRequests.
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-sp-private-key>\n-----END PRIVATE KEY-----"
SAML_SP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n<your-sp-public-certificate>\n-----END CERTIFICATE-----"

# Attribute names supplied by your IdP
SAML_EMAIL_ATTRIBUTE="email"
SAML_NAME_ATTRIBUTE="displayName"