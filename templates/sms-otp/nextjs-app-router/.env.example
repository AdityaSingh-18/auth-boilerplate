DATABASE_URL="your_neon_database_connection_string"

# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret_at_least_32_bytes_long"
OTP_SECRET="replace_with_a_different_random_secret_at_least_32_bytes_long"

# Supported providers: console, twilio, vonage
SMS_PROVIDER="console"

# Twilio credentials (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Vonage credentials (required when SMS_PROVIDER=vonage)
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_BRAND_NAME=""
